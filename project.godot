; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cube City"
config/description="Städtebau im Blockstil"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/use_custom_user_dir=true
config/custom_user_dir_name="Cube City"
config/icon="res://assets/app/icon.png"
config/macos_native_icon="res://assets/app/icon.icns"
boot_splash/image="res://assets/app/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.56, 0.75, 0.94, 1)
boot_splash/show_image=true

[autoload]

UserData="*res://scripts/core/user_data.gd"
Audio="*res://scripts/audio/audio_manager.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
